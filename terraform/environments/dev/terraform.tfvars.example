# Copy to terraform.tfvars and fill in real values before applying against
# real AWS. For LocalStack/CI testing these are overridden by -var flags,
# see .github/workflows/terraform.yml.

ssh_allowed_cidrs  = ["203.0.113.4/32"] # your actual operator IP/32, not a range
ssh_key_name       = "my-existing-ec2-keypair"
backup_bucket_name = "my-org-cryptonode-backups-change-me"
